# Environment Configuration
# Copy this file to .env and update with your values

# Backend API URL
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Must exactly match one entry in backend OAUTH_RETURN_ALLOWED_TARGETS.
# Normal local web development runs on port 8081. Native builds should use:
# EXPO_PUBLIC_OAUTH_RETURN_TARGET=mvpconnect://oauth/result
EXPO_PUBLIC_OAUTH_RETURN_TARGET=http://localhost:8081/oauth/result

# For development on physical device, use your computer's IP:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.XXX:8080

# Add other environment variables as needed
