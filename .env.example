# Safe local-development defaults for compose.yaml.
# Copy this file to .env before changing any values.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_MEDIA_BUCKET=mvpconnect-media
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_API_CORS_ALLOW_ORIGIN=*

# Use these values when starting the Spring Boot service with the local profile.
SPRING_PROFILES_ACTIVE=local
MEDIA_STORAGE_BUCKET=mvpconnect-media
MEDIA_STORAGE_ENDPOINT=http://localhost:9000
MEDIA_STORAGE_PATH_STYLE_ACCESS=true
MEDIA_STORAGE_ACCESS_KEY=minioadmin
MEDIA_STORAGE_SECRET_KEY=minioadmin
AWS_REGION=us-east-1

# Optional: enables authenticated location autocomplete through the backend.
# Enable Places API (New) for this key and restrict it to that API and your server.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_CONNECT_TIMEOUT=3s
GOOGLE_PLACES_READ_TIMEOUT=8s

# Optional: enables backend-only Spotify artist search through Client Credentials.
# Supply these to the Spring Boot process (for example, in the IntelliJ run
# configuration). Never add real values to the frontend environment.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: backend-owned external account connections. Register the exact local
# callback URLs shown here with each provider. Keep all secrets backend-only.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/external-connections/oauth/youtube/callback
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://localhost:8080/external-connections/oauth/soundcloud/callback

# Generate a random 32-byte key and Base64-encode it. This key encrypts OAuth
# credentials at rest; losing it requires users to reconnect their providers.
OAUTH_TOKEN_ENCRYPTION_KEY_BASE64=
OAUTH_TOKEN_ENCRYPTION_KEY_VERSION=1

# Comma-separated exact destinations to which the backend may return after OAuth.
OAUTH_RETURN_ALLOWED_TARGETS=mvpconnect://oauth/result,http://localhost:19006/oauth/result,http://localhost:8081/oauth/result,http://localhost:8082/oauth/result,http://localhost:8097/oauth/result
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8081,http://localhost:8082,http://localhost:19000,http://localhost:19006,http://localhost:8097
