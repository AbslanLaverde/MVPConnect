# Safe local-development defaults for compose.yaml.
# Copy this file to .env before changing any values.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_MEDIA_BUCKET=mvpconnect-media
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_API_CORS_ALLOW_ORIGIN=*

# Use these values when starting the Spring Boot service with the local profile.
SPRING_PROFILES_ACTIVE=local
MEDIA_STORAGE_BUCKET=mvpconnect-media
MEDIA_STORAGE_ENDPOINT=http://localhost:9000
MEDIA_STORAGE_PATH_STYLE_ACCESS=true
MEDIA_STORAGE_ACCESS_KEY=minioadmin
MEDIA_STORAGE_SECRET_KEY=minioadmin
AWS_REGION=us-east-1

# Optional: enables authenticated location autocomplete through the backend.
# Enable Places API (New) for this key and restrict it to that API and your server.
GOOGLE_PLACES_API_KEY=
